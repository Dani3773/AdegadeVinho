<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_logo">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_logo">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome:"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CPF/CNPJ:"
            android:background="@color/gray_logo"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtCnpjCpf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado:"
            android:background="@color/gray_logo"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editRegiao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPostalAddress"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rua / Bairro:"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gray_logo"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/edtEndereco"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:background="@drawable/edittext_shadow"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/edtBairro"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:background="@drawable/edittext_shadow"
                android:padding="12dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Responsável:"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtResponsavel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone:"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail:"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data de Cadastro:"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtDataCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="date"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAdicionarCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CADASTRAR"
            android:fontFamily="@font/league_spartan"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/black"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
