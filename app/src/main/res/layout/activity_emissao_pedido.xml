<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/gray_logo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:background="@color/gray_logo"
        android:layout_height="wrap_content">

        <TextView
            android:text="Emissão de Pedido"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@color/gray_logo"
            android:textColor="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Nome do Cliente:"
            android:textColor="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textSize="18sp"
            android:background="@color/gray_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editNomeCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="16dp" />

        <TextView
            android:text="Nome do Vinho:"
            android:textColor="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textSize="18sp"
            android:background="@color/gray_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editNomeVinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="16dp" />

        <TextView
            android:text="Quantidade:"
            android:textColor="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textSize="18sp"
            android:background="@color/gray_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editQuantidade"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnAdicionarItem"
            android:text="Adicionar Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/capivino_red_dark"
            android:textColor="@android:color/white"
            android:fontFamily="@font/league_spartan"
            android:layout_marginBottom="20dp" />

        <ListView
            android:id="@+id/listaItensPedido"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:divider="@color/capivino_red_dark"
            android:dividerHeight="1dp"
            android:background="@drawable/edittext_shadow"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:text="Forma de Pagamento:"
            android:textColor="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textSize="18sp"
            android:background="@color/gray_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spinnerFormaPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/edittext_shadow" />

        <Button
            android:id="@+id/btnFinalizarPedido"
            android:text="Finalizar Pedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/capivino_red_dark"
            android:textColor="@android:color/white"
            android:fontFamily="@font/league_spartan" />
    </LinearLayout>
</ScrollView>
