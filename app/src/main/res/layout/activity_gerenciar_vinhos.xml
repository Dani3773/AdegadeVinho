<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/gray_logo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/gray_logo">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewVinhos"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:background="@color/gray_logo" />

        <TextView
            android:text="Nome:"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:text="Tipo:"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:text="Imagem (nome do arquivo):"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextImagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:text="Descrição:"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="6"
            android:scrollbars="vertical"
            android:gravity="top|start" />

        <TextView
            android:text="Preço:"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextPreco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:text="Safra:"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextSafra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:text="Harmonização:"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editTextHarmonizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:textColor="@android:color/black"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/buttonSalvar"
                android:text="Salvar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/capivino_red_dark"
                android:textColor="@color/white"
                android:fontFamily="@font/league_spartan"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonLimpar"
                android:text="Limpar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/capivino_red_dark"
                android:textColor="@color/white"
                android:fontFamily="@font/league_spartan"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
