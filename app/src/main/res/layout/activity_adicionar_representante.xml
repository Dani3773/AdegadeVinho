<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:background="@color/gray_logo"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:background="@color/gray_logo"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome:"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtNomeRepresentante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CPF OU CNPJ:"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtCpfRepresentante"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone:"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtTelefoneRepresentante"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail:"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtEmailRepresentante"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CEP:"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/league_spartan"
            android:background="@color/gray_logo"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edtEnderecoRepresentante"
            android:background="@drawable/edittext_shadow"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnSalvarRepresentante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CADASTRAR"
            android:fontFamily="@font/league_spartan"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/black"
            android:layout_marginTop="16dp"  />
    </LinearLayout>
</ScrollView>
