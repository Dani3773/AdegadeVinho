<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/capivino_red_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/capivino_red_dark">

        <ImageView
            android:id="@+id/imagemVinhoDetalhes"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:backgroundTint="@color/capivino_red_dark"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_launcher_background" />

        <TextView
            android:id="@+id/textNomeVinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Vinho"
            android:background="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textSize="30sp"
            android:textColor="#F4A261"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/textTipoVinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Vinho"
            android:textSize="20sp"
            android:background="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textColor="#F4A261"
            android:gravity="center" />

        <TextView
            android:id="@+id/textSafraVinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safra do vinho"
            android:textSize="18sp"
            android:fontFamily="@font/league_spartan"
            android:textColor="#F4A261"
            android:background="@color/capivino_red_dark"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/textHarmonizacaoVinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harmonização do vinho"
            android:textSize="18sp"
            android:fontFamily="@font/league_spartan"
            android:textColor="#F4A261"
            android:background="@color/capivino_red_dark"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtDescricaoVinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição do vinho"
            android:fontFamily="@font/league_spartan"
            android:textSize="20sp"
            android:background="@color/capivino_red_dark"
            android:textColor="#F4A261"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtPrecoVinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 00,00"
            android:background="@color/capivino_red_dark"
            android:fontFamily="@font/league_spartan"
            android:textSize="22sp"
            android:textColor="#F4A261"
            android:gravity="center" />

        <RatingBar
            android:id="@+id/ratingEstrelas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:rating="4.0"
            android:progressTint="#F4A261"
            android:background="@color/capivino_red_dark"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Você Pode gostar:"
            android:textColor="#F4A261"
            android:fontFamily="@font/league_spartan"
            android:textStyle="bold"
            android:background="@color/capivino_red_dark"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRecomendacoes"
            android:background="@color/capivino_red_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</ScrollView>
